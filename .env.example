# Local secrets and debugging options.
# Non-secret configuration lives in config/env, target profiles and package
# lists live in config/profiles and config/packages/, and public keys and
# certificates live in keys/.

# ==============================================================================
# PGP Signing Key (ASCII-Armored Block)
# ==============================================================================

# Private PGP key (ASCII-armored) used by build scripts (bootstrap.sh,
# update.sh, build.sh, build-install.sh, build-gce.sh) to sign binary packages,
# stage3 archives, resume snapshots, ISOs, and GCE images. Stripped from stage3
# archives and never written into the live ISO .env.
# The matching public key lives in keys/signing.asc.
#
# Generate primary Certify-only key and signing subkey:
#   gpg --batch --passphrase "" \
#       --quick-generate-key "name <email@example.com>" ed25519 cert 0
#   KEY_FPR="$(gpg --list-keys --with-colons "name <email@example.com>" | \
#       awk -F: '/^fpr/ {print $10; exit}')"
#   gpg --batch --passphrase "" --quick-add-key "${KEY_FPR}" ed25519 sign 0
#
# Export secret signing subkey (stub master + secret subkey):
#   gpg --armor --export-secret-subkeys "name <email@example.com>"
#
# Export matching public key to keys/signing.asc:
#   gpg --armor --export "name <email@example.com>" > keys/signing.asc
SIGNING_KEY="-----BEGIN PGP PRIVATE KEY BLOCK-----
...
-----END PGP PRIVATE KEY BLOCK-----"

# ==============================================================================
# Secure Boot Key (PEM Block)
# ==============================================================================

# Optional PEM-encoded Secure Boot private key (written to
# /var/lib/portage/secureboot/db.key) for signing kernels and kernel modules
# during stage3/package builds. The matching certificate lives in
# keys/secureboot.pem.
#
# Generate key and certificate:
#   openssl req \
#       --days 3650 \
#       --keyout db.key \
#       --newkey rsa:4096 \
#       --noenc \
#       --out keys/secureboot.pem \
#       --subj "/CN=Secure Boot/" \
#       --x509
SECUREBOOT_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

# ==============================================================================
# S3-Compatible Storage Secrets (rclone)
# ==============================================================================

# Secret access keys used by s3_rclone() in lib/common.sh.
# If S3_SECRET_ACCESS_KEY is unset or empty, s3_rclone() uses
# S3_RO_SECRET_ACCESS_KEY (which is bundled into the live installer .env).
# Endpoint, region, bucket name, and access key ID live in config/env.
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_RO_SECRET_ACCESS_KEY="your-s3-ro-secret-access-key"

# ==============================================================================
# storage.to Uploads
# ==============================================================================

# Optional API token for storage.to CLI uploads (live installer ISOs,
# GCE disk images, and Portage build failure logs, all with 7-day expiry).
# If empty or unset, uploads fall back to `--no-token` (anonymous).
STORAGETO_KEY=""

# ==============================================================================
# Cloud & VM Image Credentials
# ==============================================================================

# Public SSH key installed to ~${IMAGE_USER}/.ssh/authorized_keys in GCE images.
# IMAGE_USER lives in config/env.
IMAGE_SSH_PUBLIC_KEY=""

# ==============================================================================
# Debugging
# ==============================================================================

# Set DEBUG=1 (or FLUFFY_DEBUG=1) to enable debug logging in lib/common.sh.
DEBUG="0"
