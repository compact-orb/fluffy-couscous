# ==============================================================================
# Ebuild & Binary Package Repositories
# ==============================================================================

# Gentoo distfiles mirror used by bootstrap.sh to fetch the initial seed stage3.
# Optional; defaults to http://distfiles.gentoo.org
GENTOO_MIRROR_URL="http://distfiles.gentoo.org"

# Newline-separated list of "<repo_name> <git_url>" entries.
# Every repository's HEAD commit must be signed by a PGP key present in keys/
# or in REPO_PUBLIC_KEYS (verified via `git verify-commit HEAD`).
REPOS="gentoo https://github.com/gentoo-mirror/gentoo.git
custom-overlay https://github.com/example/custom-overlay.git"

# Newline-separated list of "<repo_name> <base_url>" binary package mirrors.
# Used by install.sh to generate /etc/portage/binrepos.conf/<repo_name>.conf
# with sync-uri = <base_url>/<profile_path>.
BINPKG_REPOS="binhost https://s3.example.com/bucket-name/binpkgs"

# ==============================================================================
# Post-Install Provisioning
# ==============================================================================

# Git repository URL passed to `ansible-pull --url=...` inside the target chroot
# at the end of install.sh (expected to configure sudoers and system services).
ANSIBLE_PULL_URL="https://github.com/example/ansible-playbooks.git"

# ==============================================================================
# PGP Keys (ASCII-Armored Blocks)
# ==============================================================================

# Private PGP key (ASCII-armored) used by build scripts (bootstrap.sh,
# update.sh, build.sh) to sign binary packages and stage3 archives.
# Stripped from stage3 archives and never written into the live ISO .env.
#
# Generate primary Certify-only key and signing subkey:
#   gpg --batch --passphrase "" \
#       --quick-generate-key "name <email@example.com>" ed25519 cert 0
#   KEY_FPR="$(gpg --list-keys --with-colons "name <email@example.com>" | \
#       awk -F: '/^fpr/ {print $10; exit}')"
#   gpg --batch --passphrase "" --quick-add-key "${KEY_FPR}" ed25519 sign 0
#
# Export secret signing subkey (stub master + secret subkey):
#   gpg --armor --export-secret-subkeys "name <email@example.com>"
SIGNING_KEY="-----BEGIN PGP PRIVATE KEY BLOCK-----
...
-----END PGP PRIVATE KEY BLOCK-----"

# Public PGP key(s) (ASCII-armored) corresponding to SIGNING_KEY.
# Bundled into the live ISO .env and imported into /etc/portage/gnupg so
# Portage can verify signed binary packages during installation.
#
# Export public key:
#   gpg --armor --export "name <email@example.com>"
BINPKG_PUBLIC_KEY="-----BEGIN PGP PUBLIC KEY BLOCK-----
...
-----END PGP PUBLIC KEY BLOCK-----"

# Additional public PGP key(s) (ASCII-armored) used to verify `git verify-commit
# HEAD` on custom ebuild repositories in REPOS (supplements keys/*.asc).
REPO_PUBLIC_KEYS="-----BEGIN PGP PUBLIC KEY BLOCK-----
...
-----END PGP PUBLIC KEY BLOCK-----"

# Optional public PGP key(s) (ASCII-armored) used to verify legacy or
# custom seed stage3 archives during bootstrap migration.
SEED_PUBLIC_KEYS="-----BEGIN PGP PUBLIC KEY BLOCK-----
...
-----END PGP PUBLIC KEY BLOCK-----"

# ==============================================================================
# Secure Boot Keys (PEM Blocks)
# ==============================================================================

# Optional PEM-encoded Secure Boot private key (written to
# /var/lib/portage/secureboot/db.key) and certificate (written to db.pem) for
# signing kernels and kernel modules during stage3/package builds.
# build-install.sh also converts SECUREBOOT_CERT to DER on the live ISO ESP.
#
# Generate key and certificate:
#   openssl req \
#       --days 3650 \
#       --keyout db.key \
#       --newkey rsa:4096 \
#       --noenc \
#       --out db.pem \
#       --subj "/CN=Secure Boot/" \
#       --x509
SECUREBOOT_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

SECUREBOOT_CERT="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

# ==============================================================================
# S3-Compatible Storage (rclone)
# ==============================================================================

# Credentials and endpoint used by s3_rclone() in lib/common.sh to access:
#   - :s3:<S3_BUCKET_NAME>/stage3-<profile>.tar.zst (and .sig)
#   - :s3:<S3_BUCKET_NAME>/binpkgs/<profile>/
# If S3_SECRET_ACCESS_KEY is unset or empty, s3_rclone() falls back to
# S3_RO_SECRET_ACCESS_KEY (which is bundled into the live installer .env).
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_RO_SECRET_ACCESS_KEY="your-s3-ro-secret-access-key"
S3_REGION="auto"
S3_ENDPOINT="https://s3.example.com"
S3_BUCKET_NAME="gentoo-binhost"

# ==============================================================================
# storage.to Uploads
# ==============================================================================

# Optional API token for storage.to CLI uploads (live installer ISOs and
# automatic Portage build failure log archives, both set to 7-day expiry).
# If empty or unset, uploads fall back to `--no-token` (anonymous).
STORAGETO_KEY=""

# ==============================================================================
# Debugging
# ==============================================================================

# Set DEBUG=1 (or FLUFFY_DEBUG=1) to enable debug logging in lib/common.sh.
DEBUG="0"
